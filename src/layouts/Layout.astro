  <script>
    const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
    const headerNavigation = document.querySelector<HTMLElement>("#header-navigation");

    if (menuToggle && headerNavigation) {
      const closeMenu = () => {
        menuToggle.setAttribute("aria-expanded", "false");
        headerNavigation.classList.remove("is-open");
      };

      menuToggle.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        headerNavigation.classList.toggle("is-open", !isOpen);
      });

      headerNavigation.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeMenu();
          menuToggle.focus();
        }
      });
    }
  </script>
  </body>

  <style>
    .hero-visual { aspect-ratio: 1; background: #dfe8df; border-radius: 50%; height: 64px; max-width: 64px; overflow: hidden; position: relative; width: 64px; }
    .orbit { border: 1px solid rgba(23, 35, 31, .3); border-radius: 50%; left: 50%; position: absolute; top: 50%; transform: translate(-50%, -50%) rotate(-24deg); }
    .orbit-one { height: 55%; width: 120%; }
    .orbit-two { height: 90%; transform: translate(-50%, -50%) rotate(54deg); width: 75%; }
    .planet { background: #7b9b9a; border-radius: 50%; height: 45%; left: 28%; position: absolute; top: 31%; width: 45%; }
    .planet::after { background: rgba(235, 239, 216, .35); border-radius: 50%; content: ""; height: 14%; left: 22%; position: absolute; top: 22%; width: 42%; }
    .planet-label { color: #e8eee1; display: block; font-size: .65rem; letter-spacing: .15em; line-height: 1.7; margin: 37% 0 0 24%; }
    .satellite { background: #e18f5f; border-radius: .2rem; color: var(--color-surface); font-size: .6rem; font-weight: 700; left: 66%; letter-spacing: .1em; padding: .6rem; position: absolute; top: 20%; transform: rotate(12deg); }
    .satellite small { font-size: .5rem; }
  </style>
