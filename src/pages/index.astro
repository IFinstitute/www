---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import {
  categoryLabels,
  latestPublications,
  paperTypeLabels,
  presentationTagLabels,
  type PublicationCategory,
} from "../data/publications";

const base = import.meta.env.BASE_URL;

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.

const publicationCategories: PublicationCategory[] = [
  "first-authored-papers",
  "first-authored-presentations",
];
---

<Layout title="Yosuke MORIYAMA">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">PROFILE</p>
          <h1 id="hero-title">森山 陽介<br /><em>Yosuke MORIYAMA</em></h1>
          <p class="profile-role">
            電気通信大学 津田研究室<br />
            博士後期課程 / 日本学術振興会 特別研究員（DC1）
          </p>
          <p class="hero-lead">
            ひまわり8号・9号をはじめとする衛星観測データを用いて、
            極中間圏雲と地球中層・超高層大気の変動を研究しています。
          </p>
          <div class="profile-facts">
            <div>
              <dt>Research field</dt>
              <dd>(極域) 大気科学・衛星リモートセンシング</dd>
            </div>
            <div>
              <dt>Keywords</dt>
              <dd>PMC / NLC / Himawari / Middle atmosphere / Upper atmosphere</dd>
            </div>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="#research">News & Achievement<span>↓</span></a>
            <a class="button button-quiet" href="#profile">Research →</a>
          </div>
        </div>
        <div class="hero-visual" aria-label="森山陽介のプロフィール画像">
          <img
            src={`${base}073A1948.jpg`}
            alt="森山陽介のプロフィール画像"
            width="600"
            height="600"
          />
        </div>
      </section>
    <!-- <div>
      日本の静止軌道衛星ひまわり 8 号 / 9 号による極中間圏雲 (Polar Mesospheric
      Clouds: PMC) の観測データを中心とした地球大気観測衛星データを用いて、PMC
      と地球中層・超高層大気変動の関係について研究しています。
    </div> -->
    <section class="timeline" aria-label="経歴タイムライン">
      <h2>Timeline</h2>

      <ul class="timeline-list">
        <li class="timeline-item">
          <time class="timeline-date" datetime="2026-07">2026.07</time>
          <p class="timeline-title" id="ospa_2026">学生優秀発表賞 / Outstanding Student Presentation Awards</p>
          <p class="timeline-text">
            日本地球惑星科学連合 / Japan Geoscience Union
            <ul>
              <li>
                <a href="https://www.uec.ac.jp/news/prize/2026/20260819_7883.html"
                  >電通大プレスリリース / UEC Press Release</a
                >
              </li>
            </ul>
          </p>
        </li>
        <li class="timeline-item">
          <time class="timeline-date" datetime="2026-04">2026.04</time>
          <p class="timeline-title">日本学術振興会 特別研究員 (DC1)</p>
          <p class="timeline-text">
            電気通信大学 大学院情報理工学研究科 情報・ネットワーク工学専攻
          </p>
        </li>
        <li class="timeline-item">
          <time class="timeline-date" datetime="2026-03">2026.03</time>
          <p class="timeline-title">令和7年度学生表彰</p>
          <p class="timeline-text">
            研究活動で顕著な成果 ＜個人＞, 電気通信大学
          </p>
        </li>
        <!-- <li class="timeline-item"> -->
          <!-- <time class="timeline-date" datetime="2026-03">2026.03</time> -->
          <p class="timeline-title">電気通信大学 大学院情報理工学研究科 博士前期課程 修了</p>
          <p class="timeline-text">
            修士 (工学) を取得。
            <ul>
              <li>
                修士論文発表会 優秀発表賞, 電気通信大学 大学院情報理工学研究科 情報・ネットワーク工学専攻 電子情報学プログラム
              </li>
              <li>
                令和7年度 目黒会賞, 一般社団法人 目黒会
              </li>
            </ul>
          </p>
        <!-- </li> -->
        <!-- <li class="timeline-item"> -->
          <!-- <time class="timeline-date" datetime="2026-03">2026.03</time> -->
          <p class="timeline-title" id="EPS_highlight_2025">EPS Highlighted Papers 2025</p>
          <p class="timeline-text">
            Responses of polar mesospheric
            clouds to water vapor anomalies caused by the 2022 Hunga Tonga-Hunga Ha'apai
            eruption, Y. Moriyama, T. T. Tsuda, Y. Ando, H. Suzuki, H. Nakagawa, T.
            Nishiyama, Y.-M. Tanaka, K. T. Murata, J. Yue
            <ul>
              <li>
                <a href="https://link.springer.com/journal/40623/updates/27793928"
                  >EPS Highlighted Papers</a
                >
              </li>
            </ul>
          </p>
        </li>

        <li class="timeline-item">
          <time class="timeline-date" datetime="2025-11">2025.11</time>
          <p class="timeline-title" id="auroral_medal_2025">最優秀発表賞（オーロラメダル）</p>
          <p class="timeline-text">「2022年トンガ噴火の水蒸気異常が極中間圏雲活動に与える影響に関するひまわり8号/9号の観測に基づく研究」（R005-07）,
            地球電磁気・地球惑星圏学会
            <ul>
              <li>
                <a href="https://www.uec.ac.jp/news/prize/2026/20260612_7758.html"
                  >電通大プレスリリース / UEC Press Release</a
                >
              </li>
            </ul>
          </p>
        </li>

        <li class="timeline-item">
          <time class="timeline-date" datetime="2024-03">2024.03</time>
          <p class="timeline-title">電気通信大学 情報理工学域 卒業</p>
          <p class="timeline-text">
            学士 (工学)、中学校教諭第一種免許状 (数学)、高等学校教諭第一種免許状 (数学)、高等学校教諭第一種免許状 (情報) を取得。
            <ul>
              <li>
                卒業研究発表会 優秀発表賞, 電気通信大学 情報理工学域 II
                類 (融合系) 電子情報学プログラム
              </li>
              <li>
                令和5年度 目黒会賞, 一般社団法人 目黒会
              </li>
            </ul>
          </p>
        </li>
      </ul>
    </section>

    <section class="pubs-section" aria-labelledby="publication-preview-title">
      <div class="section-heading">
        <p class="eyebrow">PUBLICATIONS & PRESENTATIONS</p>
        <h2 id="publication-preview-title">研究業績 / Achievement</h2>
        <p class="pubs-lead">最新3件
          <a class="pubs-nav" href=`${base}pubs/`>すべての業績を見る →</a>
        </p>
      </div>
      <div class="pubs-list">
        {publicationCategories.map((category) => (
          <section class="pubs-section">
            <h3>{categoryLabels[category]}</h3>
            {latestPublications(category).length > 0 ? (
              <ol>
                {latestPublications(category).map((item) => (
                  <li class="pub-item">
                    <h3>{item.title}</h3>
                    <p>{item.citation}</p>
                    {item.doi && (
                      <a href={`https://doi.org/${item.doi}`} target="_blank" rel="noopener noreferrer">
                        DOI: {item.doi} ↗
                      </a>
                    )}
                    <div class="pub-meta">
                      <span>{item.venue}</span>
                      <time datetime={item.date}>
                        {item.date.slice(0, 4)}
                      </time>
                    </div>
                    <p class="pub-tags" aria-label="業績種別">
                      {item.paperType && <span>{paperTypeLabels[item.paperType]}</span>}
                      {item.presentationTags?.map((tag) => <span>{presentationTagLabels[tag]}</span>)}
                    </p>
                    {item.remarks && (
                      <ul class="pub-remarks" aria-label="備考">
                        {item.remarks.map((remark) => (
                          <li>
                            {remark.url ? (
                              <a href={remark.url} target={remark.url.startsWith("#") ? undefined : "_blank"} rel={remark.url.startsWith("#") ? undefined : "noopener noreferrer"}>
                                {remark.label}
                              </a>
                            ) : (
                              remark.label
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ol>
            ) : (
              <p class="no-publications">T.B.D</p>
            )}
          </section>
        ))}
      </div>
    </section>
</Layout>

<style>
  .profile-role { color: var(--foreground); line-height: 1.9; }
  .profile-facts { display: grid; gap: 0; }
  .profile-facts > div { border-top: 1px solid #d5ddd5; display: grid; gap: 1rem; grid-template-columns: 8rem 1fr; padding: 1.2rem 0; }
</style>
